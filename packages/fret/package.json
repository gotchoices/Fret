    "libp2p": "^3.3.11"
  },
  "devDependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/circuit-relay-v2": "^4.2.13",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/identify": "^4.1.14",
    "@libp2p/interface": "^3.3.0",
    "@libp2p/memory": "^2.0.28",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/plaintext": "^3.0.28",
    "@libp2p/tcp": "^11.0.28",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.2",
    "chai": "^6.2.2",
    "fast-check": "^4.5.3",
    "libp2p": "^3.3.11",
    "mocha": "^11.7.5",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
