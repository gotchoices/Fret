  "type": "module",
  "description": "FRET: Finger Ring Ensemble Topology (libp2p ring overlay with Digitree)",
  "main": "dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "src",
    "dist",
    "!dist/test",
    "!**/*.tsbuildinfo"
  ],
